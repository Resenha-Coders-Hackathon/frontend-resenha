# Public browser configuration; never put secrets in VITE_* values.
# Optional in production: defaults to /api/v1 (the same-origin reverse proxy).
# In development the browser always uses /api/v1 through Vite's proxy.
VITE_API_BASE_URL=/api/v1
# Development only, server-side: Docker image defaults to http://backend:8000.
# API_PROXY_TARGET=http://127.0.0.1:8000
VITE_GOOGLE_CLIENT_ID=
VITE_MAPBOX_API_KEY=
VITE_API_KEY=
VITE_AUTH_DOMAIN=
VITE_PROJECT_ID=
VITE_STORAGE_BUCKET=
VITE_MESSAGING_SENDER_ID=
VITE_APP_ID=
VITE_MEASUREMENT_ID=
# Firebase Web Push key (Cloud Messaging > Web Push certificates)
VITE_VAPID_KEY=
# Google Sign-In (must match GOOGLE_CLIENT_ID on the backend)
VITE_GOOGLE_CLIENT_ID=
