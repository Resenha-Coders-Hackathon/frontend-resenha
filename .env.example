# Backend base URL including the API prefix, no trailing slash
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Firebase (push notifications). Anything VITE_* is public.
VITE_API_KEY=
VITE_AUTH_DOMAIN=
VITE_PROJECT_ID=
VITE_STORAGE_BUCKET=
VITE_MESSAGING_SENDER_ID=
VITE_APP_ID=
VITE_MEASUREMENT_ID=
# Firebase Web Push key (Cloud Messaging > Web Push certificates)
VITE_VAPID_KEY=
